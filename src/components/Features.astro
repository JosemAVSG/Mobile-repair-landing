---
import { features, ticketSteps } from '../data/site';
import Icon from './Icon.astro';

const [orders, inventory, ...rest] = features;
const doneUntil = 2; // ejemplo de la página pública: equipo "En reparación"
---

<section id="funciones" aria-labelledby="funciones-titulo" class="pb-20 sm:pb-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="funciones-titulo" class="max-w-xl text-3xl font-extrabold tracking-[-0.02em] sm:text-[2.75rem] sm:leading-tight">
      Un solo sistema para todo el taller.
    </h2>

    <div class="mt-12 grid gap-4 lg:grid-cols-6">
      <!-- Protagonista: seguimiento por QR -->
      <article class="rounded-lg bg-graphite p-6 text-on-dark sm:p-8 lg:col-span-4 lg:row-span-2">
        <span class="text-kapton"><Icon name="QrCode" class="size-8" /></span>
        <h3 class="mt-5 text-2xl font-bold sm:text-3xl">Seguimiento por QR</h3>
        <p class="mt-3 max-w-md leading-relaxed text-on-dark-muted">
          Tu cliente escanea el ticket y ve el estado de su equipo desde el celular, sin crear cuenta. Menos
          llamadas, menos mensajes, más tiempo en el banco de trabajo.
        </p>
        <div class="mt-8 max-w-sm rounded-md bg-surface p-5 text-ink">
          <p class="label-mono text-muted">Orden #2210 · MacBook Air M1</p>
          <ol class="mt-4 space-y-3" aria-label="Estados de la reparación">
            {
              ticketSteps.map((s, i) => (
                <li class="flex items-center gap-3 text-sm">
                  <span
                    class:list={[
                      'size-3 rounded-sm',
                      i < doneUntil && 'bg-ink',
                      i === doneUntil && 'bg-kapton outline-2 outline-offset-2 outline-kapton',
                      i > doneUntil && 'border border-border',
                    ]}
                    aria-hidden="true"
                  />
                  <span class:list={[i <= doneUntil ? 'font-semibold' : 'text-muted']}>
                    {s.label}
                    {i === doneUntil && <span class="sr-only"> (estado actual)</span>}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </article>

      {
        [orders, inventory].map((f) => (
          <article class="rounded-lg border border-border bg-surface p-6 transition-colors duration-[120ms] lg:col-span-2 [@media(pointer:fine)]:hover:border-ink">
            <div class="flex items-start justify-between gap-3">
              <span class="text-kapton-ink">
                <Icon name={f.icon as any} />
              </span>
              {f.tag && <span class="label-mono rounded-sm border border-warning px-2 py-0.5 text-warning">{f.tag}</span>}
            </div>
            <h3 class="mt-5 text-lg font-bold">{f.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{f.text}</p>
          </article>
        ))
      }

      {
        rest.map((f) => (
          <article class="rounded-lg border border-border bg-surface p-6 transition-colors duration-[120ms] lg:col-span-2 [@media(pointer:fine)]:hover:border-ink">
            <span class="text-kapton-ink">
              <Icon name={f.icon as any} />
            </span>
            <h3 class="mt-5 text-lg font-bold">{f.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
