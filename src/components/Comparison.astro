---
import { comparison, site } from '../data/site';
import Icon from './Icon.astro';
---

<section aria-labelledby="comparacion" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="comparacion" class="max-w-xl text-3xl font-extrabold tracking-[-0.02em] sm:text-[2.75rem] sm:leading-tight">
      Lo que cambia en el mostrador.
    </h2>
    <table class="mt-12 w-full border-collapse text-left">
      <caption class="sr-only">Comparación del trabajo diario sin sistema y con {site.name}</caption>
      <thead class="hidden md:table-header-group">
        <tr class="border-b-2 border-ink">
          <th scope="col" class="label-mono w-1/3 py-3 pr-6 text-muted">Situación</th>
          <th scope="col" class="label-mono w-1/3 py-3 pr-6 text-muted">Sin sistema</th>
          <th scope="col" class="label-mono w-1/3 py-3 text-ink">Con {site.name}</th>
        </tr>
      </thead>
      <tbody>
        {
          comparison.map((row) => (
            <tr class="block border-b border-border py-5 md:table-row md:py-0">
              <th scope="row" class="block pb-3 font-mono text-sm font-medium md:table-cell md:py-5 md:pr-6 md:align-top">
                {row.situation}
              </th>
              <td class="flex gap-3 py-1 text-muted md:table-cell md:py-5 md:pr-6 md:align-top">
                <span class="label-mono w-24 shrink-0 pt-0.5 md:hidden">Sin sistema</span>
                <span class="flex gap-2">
                  <span class="mt-0.5 hidden text-subtle md:inline"><Icon name="X" class="size-4" /></span>
                  {row.before}
                </span>
              </td>
              <td class="flex gap-3 py-1 font-semibold md:table-cell md:py-5 md:align-top">
                <span class="label-mono w-24 shrink-0 pt-0.5 font-medium text-muted md:hidden">Con sistema</span>
                <span class="flex gap-2">
                  <span class="mt-0.5 text-success"><Icon name="Check" class="size-4" /></span>
                  {row.after}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
