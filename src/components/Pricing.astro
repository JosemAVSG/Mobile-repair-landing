---
import { plans, site } from '../data/site';
import Icon from './Icon.astro';

const cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
const whatsapp = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hola, me interesa el plan Empresarial de ${site.name}`)}`
  : `mailto:${site.contactEmail}?subject=${encodeURIComponent(`Plan Empresarial de ${site.name}`)}`;
---

<section id="precios" aria-labelledby="precios-titulo" class="border-t border-border py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="precios-titulo" class="text-3xl font-extrabold tracking-[-0.02em] sm:text-[2.75rem] sm:leading-tight">
        Precios claros, sin permanencia.
      </h2>
      <p class="mt-4 text-lg text-muted">
        Prueba {site.name} gratis por {site.trialDays} días con todas las funciones. Sin tarjeta para empezar; cancela
        cuando quieras.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        plans.map((plan) => (
          <li
            class:list={[
              'relative flex flex-col rounded-lg border bg-surface p-6 sm:p-8',
              plan.highlighted ? 'border-2 border-kapton' : 'border-border',
            ]}
          >
            {plan.highlighted && (
              <span class="label-mono absolute -top-3 left-6 rounded-sm bg-kapton px-2 py-0.5 text-ink">
                Más elegido
              </span>
            )}
            <h3 class="font-display text-xl font-bold">{plan.name}</h3>
            <p class="mt-2 min-h-12 text-sm text-muted">{plan.tagline}</p>
            <p class="mt-6 flex items-baseline gap-1.5">
              {plan.price ? (
                <>
                  <span class="text-4xl font-extrabold tracking-[-0.02em]">{cop.format(plan.price)}</span>
                  <span class="text-sm text-muted">COP / mes</span>
                </>
              ) : (
                <span class="text-4xl font-extrabold tracking-[-0.02em]">A convenir</span>
              )}
            </p>
            <ul class="mt-6 flex-1 space-y-3 border-t border-border pt-6 text-sm">
              {plan.features.map((f) => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 shrink-0 text-success">
                    <Icon name="Check" class="size-4" />
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            {plan.price ? (
              <a
                href={site.signupUrl}
                class:list={[
                  'mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-md px-6 font-semibold transition-[filter] duration-[120ms]',
                  plan.highlighted
                    ? 'bg-kapton text-ink hover:brightness-95'
                    : 'border-2 border-ink text-ink hover:bg-bench',
                ]}
              >
                Empezar prueba gratis
                <Icon name="ArrowRight" class="size-5" />
              </a>
            ) : (
              <a
                href={whatsapp}
                class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-md border-2 border-ink px-6 font-semibold text-ink hover:bg-bench"
              >
                <Icon name="MessageCircle" class="size-5" />
                Hablar con ventas
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm text-muted">
      Precios en pesos colombianos. El cobro es mensual con tarjeta a través de Wompi; puedes cambiar de plan o
      cancelar desde la app.
    </p>
  </div>
</section>
