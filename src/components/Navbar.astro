---
import { site } from '../data/site';
import Icon from './Icon.astro';

const links = [
  { href: '#funciones', label: 'Funciones' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<a
  href="#contenido"
  class="sr-only z-80 rounded-md bg-kapton px-4 py-2 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  Saltar al contenido
</a>
<header
  id="nav"
  data-theme="dark"
  class="group fixed inset-x-0 top-0 z-30 border-b border-transparent bg-graphite text-on-dark transition-colors duration-[280ms] data-[theme=light]:border-border data-[theme=light]:bg-bench/95 data-[theme=light]:text-ink data-[theme=light]:backdrop-blur"
>
  <nav aria-label="Principal" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#" class="flex items-center gap-2.5 font-display font-bold" style="font-stretch: 112%">
      <span class="grid size-9 place-items-center rounded-md bg-kapton text-ink">
        <Icon name="Wrench" class="size-5" />
      </span>
      <span>{site.name}</span>
    </a>
    <ul class="hidden items-center gap-8 text-sm font-medium md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-on-dark-muted hover:text-on-dark group-data-[theme=light]:text-muted group-data-[theme=light]:hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2 sm:gap-4">
      <a href={site.loginUrl} class="inline-flex min-h-11 items-center px-2 text-sm font-semibold">Ingresar</a>
      <a
        href="#contacto"
        class="inline-flex min-h-11 items-center rounded-md bg-kapton px-4 text-sm font-semibold text-ink transition-[filter] duration-[120ms] hover:brightness-95"
      >
        {site.ctaLabel}
      </a>
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('nav');
  const hero = document.getElementById('hero');
  if (nav && hero) {
    new IntersectionObserver(
      ([entry]) => {
        nav.dataset.theme = entry.isIntersecting ? 'dark' : 'light';
      },
      { rootMargin: '-64px 0px 0px 0px' },
    ).observe(hero);
  }
</script>
